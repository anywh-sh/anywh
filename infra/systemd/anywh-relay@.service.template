[Unit]
Description=anywh relay (%i profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{WORKING_DIRECTORY}}
# Loaded in listed order — a later file's values win over an earlier file's
# on the same key. Put anything shared across every profile (AGENT_BIN,
# EXTRA_PATH_DIRS) in the first file, and per-profile overrides (RELAY_PORT,
# RELAY_HOME_OVERRIDE, ...) in the second. The "-" prefix makes both files
# optional, so a single-profile setup can skip either or both and run on
# the relay's own built-in defaults.
# The profile id, also used to find this profile's agent host socket
# (anywh-agent-host@%i, which sets the same variable).
Environment=ANYWH_PROFILE=%i
EnvironmentFile=-{{WORKING_DIRECTORY}}/.env
EnvironmentFile=-{{ENV_DIR}}/%i.env
ExecStart={{NODE_BIN}} dist/server.js
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=300

[Install]
WantedBy=default.target
