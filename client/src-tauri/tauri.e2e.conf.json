{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:frontend:e2e"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        "desktop",
        {
          "identifier": "e2e",
          "description": "WebDriverIO test automation (client/tests/e2e) — only merged in via --config tauri.e2e.conf.json, never part of a normal tauri dev/build.",
          "windows": ["*"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://127.0.0.1:47864/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNTdFNkIzQkY2RjgyOEMKUldTTWdtKy9zK1pYTVM3TGRRU1VCWkZnNUhQUEY3T3hzZVVqSWd1c3pRSVNlNUNyK0VScUZVVlQK"
    }
  }
}
